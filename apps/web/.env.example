# ============================================================================
# Переменные СБОРКИ фронтенда. Vite читает .env из apps/web (НЕ из корня репо).
# Скопируйте: cp .env.example .env  — но для локального dev это НЕ нужно.
# ============================================================================
# ВАЖНО: всё, что начинается на VITE_, попадает в публичный JS-бандл.
# Секреты (BOT_TOKEN, service key, JWK, DATABASE_URL) сюда класть ЗАПРЕЩЕНО.

# --- Локальная разработка ---------------------------------------------------
# Оставьте VITE_API_BASE_URL НЕЗАДАННЫМ: vite.config.ts проксирует
# /v1 и /health на http://127.0.0.1:3000 (бот). Если задать этот URL,
# прокси будет обойдён и каталог в dev окажется пустым.
# VITE_API_BASE_URL=https://api.example.com

# --- Production / Cloudflare Pages (build-time env) -------------------------
# VITE_API_BASE_URL=https://api.<your-domain>
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_CDN_BASE_URL=https://<cdn>/catalog
# VITE_MINIAPP_VERSION=0.2.0
# VITE_DEFAULT_LOCALE=ru
