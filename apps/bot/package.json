{
  "name": "@case-sim/bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Railway: Hono REST v1 + grammY Telegram bot + Stars XTR webhook",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@case-sim/shared": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@supabase/supabase-js": "2.119.0",
    "grammy": "1.46.0",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
