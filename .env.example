# ============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ. НИКОГДА НЕ КОММИТИТЬ РЕАЛЬНЫЕ ЗНАЧЕНИЯ.
# Секреты хранятся в Railway Service Variables / Supabase Secrets / GitHub Secrets
# ============================================================================

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # @BotFather; только на сервере
TELEGRAM_BOT_USERNAME=         # без @
TELEGRAM_WEBHOOK_SECRET=       #случайная строка для проверки X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_URL=          # https://<railway-domain>/telegram/webhook
TELEGRAM_USE_TEST_ENV=false    # true → https://api.telegram.org/bot<token>/test/METHOD

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...     # можно на клиент
SUPABASE_SECRET_KEY=sb_secret_...               # ТОЛЬКО сервер, обходит RLS
SUPABASE_JWT_JWK=                              # приватный ES256 JWK (Signing Keys)
DATABASE_URL=postgresql://postgres.<ref>:[pw]@<host>:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres.<ref>:[pw]@<host>:5432/postgres

# --- Railway / сервис -------------------------------------------------------
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
SENTRY_DSN=
HEALTHCHECK_PATH=/health
RAILWAY_REGION=europe-west4-drams3a

# --- Фронтенд (VITE_* уходят в бандл — НЕ класть сюда секреты) -------------
VITE_API_BASE_URL=https://api.example.com
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_CDN_BASE_URL=https://<cdn>/catalog
VITE_MINIAPP_VERSION=1.0.0
VITE_DEFAULT_LOCALE=ru

# --- Игровые параметры ------------------------------------------------------
PRICE_SNAPSHOT_ID=2026-11-05-skinport
INIT_DATA_TTL_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24
MAX_BET_DEFAULT=1000
ROUND_TICK_MS=100
