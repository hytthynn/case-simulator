{
  "name": "@case-sim/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Telegram Mini App SPA (Vite + React 19 + Tailwind CSS 4)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node ../../infra/scripts/copy-headers.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@case-sim/shared": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
