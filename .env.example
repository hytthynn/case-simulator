# ============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ. Скопируйте: cp .env.example .env
# .env лежит в .gitignore и НЕ коммитится.
#
# НИКОГДА не вставляйте реальные значения в .env.example, в чат или скриншот.
# Если токен бота уже где-то засветился — @BotFather → /revoke (перевыпуск).
#
# ВАЖНО: все секретные значения здесь ПУСТЫЕ. Не оставляйте плейсхолдеры
# вида <project-ref>, sb_secret_..., api.example.com — бот посчитает конфигурацию
# готовой и упадёт при подключении к несуществующему Supabase.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# @BotFather → /newbot. Формат: 123456789:AA... . Только сервер / Railway Secrets.
TELEGRAM_BOT_TOKEN=

# Имя бота БЕЗ @: @BotFather → /setname
TELEGRAM_BOT_USERNAME=

# Случайная строка для X-Telegram-Bot-Api-Secret-Token: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# После деплоя Railway: https://<service>.up.railway.app/telegram/webhook
# Путь /telegram/webhook ОБЯЗАТЕЛЕН, только HTTPS.
TELEGRAM_WEBHOOK_URL=

# true → тестовое окружение Telegram (тестовые звёзды, Bot API /test/). Prod = false.
TELEGRAM_USE_TEST_ENV=false

# --- Supabase ---------------------------------------------------------------
# Project Settings → API → Project URL: https://<ref>.supabase.co
SUPABASE_URL=

# Project Settings → API → Publishable key (sb_publishable_...). Можно на клиент.
SUPABASE_PUBLISHABLE_KEY=

# Project Settings → API → Secret key (sb_secret_...). ТОЛЬКО сервер, обходит RLS.
SUPABASE_SECRET_KEY=

# Приватный ES256 JWK ОДНОЙ СТРОКОЙ JSON, обязательно с kid:
#   supabase gen signing-key --algorithm ES256
# ЗАТЕМ импортируйте его в Dashboard → Project Settings → JWT Signing Keys
# → Create standby key → Rotate key. Без импорта Supabase не примет ваш JWT.
# Форма: {"kty":"EC","kid":"...","d":"...","crv":"P-256","x":"...","y":"..."}
SUPABASE_JWT_JWK=

# Project Settings → Database → Connect: pooler :6543 и direct :5432
# Нужны для сида каталога в прод (deploy.yml, флаг seed_catalog=true).
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- Railway / сервис -------------------------------------------------------
# Railway инжектит PORT сам; локально оставьте 3000.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SENTRY_DSN=
HEALTHCHECK_PATH=/health
RAILWAY_REGION=europe-west4-drams3a

# --- Фронтенд: VITE_* уходят в бандл, НЕ класть сюда секреты ---------------
# Vite читает .env из apps/web/, а НЕ из корня: apps/web/.env.example.
# В dev НЕ задавайте VITE_API_BASE_URL — vite.config.ts проксирует /v1 → :3000.
# Для production задайте как build-time env в Cloudflare Pages:
#   VITE_API_BASE_URL=https://api.<domain>
#   VITE_SUPABASE_URL=https://<ref>.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   VITE_CDN_BASE_URL=https://<cdn>       # БЕЗ /catalog: пути в БД уже его содержат
#   VITE_MINIAPP_VERSION=0.2.0
#   VITE_DEFAULT_LOCALE=ru

# --- Игровые параметры (interim, docs/08-game-logic.md) --------------------
PRICE_SNAPSHOT_ID=2026-11-05-skinport
INIT_DATA_TTL_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24
MAX_BET_DEFAULT=1000
ROUND_TICK_MS=100
